{
  "name": "@sidechannel/integration",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@sidechannel/contracts": "1.0.0",
    "@sidechannel/domain": "1.0.0",
    "@sidechannel/persistence": "1.0.0",
    "@sidechannel/api": "1.0.0",
    "@sidechannel/experiment-worker": "1.0.0",
    "@sidechannel/analysis-worker": "1.0.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "26.6.6",
    "tsx": "4.21.0",
    "mongodb": "7.7.0",
    "zod": "4.6.7"
  },
  "scripts": {
    "test": "node ../../scripts/test.mjs .",
    "test:integration": "node --env-file-if-exists=../../.env --env-file-if-exists=.env ../../scripts/test.mjs . --mongo",
    "smoke:dashboard": "tsx dashboard-smoke.ts",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "smoke:jev": "tsx --env-file-if-exists=../../.env --env-file-if-exists=.env jev-smoke.ts"
  },
  "nx": {
    "tags": [
      "layer:test"
    ],
    "targets": {
      "test:integration": {
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      },
      "smoke:dashboard": {
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      },
      "smoke:jev": {
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}
