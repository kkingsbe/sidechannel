# Shared host-development defaults. Process variables take precedence.
# Existing agent/.env is a compatibility fallback; service .env overrides file defaults.
MONGODB_URI=mongodb://127.0.0.1:27018/?directConnection=true&replicaSet=rs0
MONGODB_DB_NAME=sidechannel
MASTRA_DB_NAME=sidechannel_mastra
# Keep model credentials out of the dashboard and run configuration JSON.
OPENAI_API_KEY=
ADAPTION_API_KEY=
TYPESAFE_API_KEY=
# TYPESAFE_AI_API_KEY is also accepted by the Jev adapter.
