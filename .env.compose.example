# Copy to root .env.compose once; do not overwrite an existing configured file.
# Explicit --env-file .env.compose does not load root .env or service .env files.
RESEARCHER_TOKEN=
OPENAI_API_KEY=
ADAPTION_API_KEY=
TYPESAFE_API_KEY=
# TYPESAFE_AI_API_KEY is a fallback if TYPESAFE_API_KEY is blank.
MONGODB_DB_NAME=sidechannel
MASTRA_DB_NAME=sidechannel_mastra
# Preserve the existing token file. Required only for the tunnel profile.
CLOUDFLARE_TUNNEL_TOKEN_FILE=./agent/secrets/cloudflare-tunnel-token.txt
# Optional published image references; leave blank for local builds.
API_IMAGE=
EXPERIMENT_WORKER_IMAGE=
ANALYSIS_WORKER_IMAGE=
MASTRA_IMAGE=
