# Credentials for live experiment inference only; scripted fixtures need no key.
OPENAI_API_KEY=
ADAPTION_API_KEY=

# Parallel run lanes in this worker (1-16, default 4; 1 runs one at a time).
WORKER_CONCURRENCY=4
# Total attempts per model request for rate limits/provider errors (1-10, default 5; 1 disables retries).
INFERENCE_MAX_ATTEMPTS=5
