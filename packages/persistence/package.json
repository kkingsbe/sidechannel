{
  "name": "@sidechannel/persistence",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node ../../scripts/test.mjs src",
    "lint": "eslint src",
    "dev": "tsc -w -p tsconfig.build.json"
  },
  "dependencies": {
    "mongodb": "7.7.0",
    "@sidechannel/contracts": "1.0.0",
    "@sidechannel/domain": "1.0.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "26.6.6",
    "tsx": "4.21.0"
  },
  "nx": {
    "tags": [
      "layer:persistence"
    ],
    "targets": {
      "dev": {
        "cache": false,
        "continuous": true
      }
    }
  },
  "exports": {
    "./analysis/comparison-repository": {
      "types": "./dist/analysis/comparison-repository.d.ts",
      "import": "./dist/analysis/comparison-repository.js"
    },
    "./analysis/jev-repository": {
      "types": "./dist/analysis/jev-repository.d.ts",
      "import": "./dist/analysis/jev-repository.js"
    },
    "./analysis/review-repository": {
      "types": "./dist/analysis/review-repository.d.ts",
      "import": "./dist/analysis/review-repository.js"
    },
    "./analysis/store": {
      "types": "./dist/analysis/store.d.ts",
      "import": "./dist/analysis/store.js"
    },
    "./harness/repository": {
      "types": "./dist/harness/repository.d.ts",
      "import": "./dist/harness/repository.js"
    },
    "./harness/mastra-purge": {
      "types": "./dist/harness/mastra-purge.d.ts",
      "import": "./dist/harness/mastra-purge.js"
    },
    "./healthcare/catalog": {
      "types": "./dist/healthcare/catalog.d.ts",
      "import": "./dist/healthcare/catalog.js"
    },
    "./playbook/catalog": {
      "types": "./dist/playbook/catalog.d.ts",
      "import": "./dist/playbook/catalog.js"
    }
  }
}
