# Copy to .env.compose. Keep real values out of git and chat.
# Generate a long random token; the dashboard refuses a nonloopback bind without it.
RESEARCHER_TOKEN=
OPENAI_API_KEY=
MONGODB_DB_NAME=sidechannel
MASTRA_DB_NAME=sidechannel_mastra
# Only needed with --profile tunnel. File contains the tunnel token, not JSON.
CLOUDFLARE_TUNNEL_TOKEN_FILE=./secrets/cloudflare-tunnel-token.txt
