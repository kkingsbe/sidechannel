{
  "name": "sidechannel-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/dev.mjs dashboard",
    "build": "tsc -b && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run --maxWorkers=2",
    "lint": "eslint src vite.config.ts",
    "dev:local": "vite --host 127.0.0.1",
    "start": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "tailwind-merge": "3.7.0",
    "@sidechannel/contracts": "1.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "27.4.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.1.0"
  },
  "nx": {
    "tags": [
      "layer:frontend"
    ],
    "targets": {
      "dev": {
        "cache": false,
        "continuous": true,
        "dependsOn": [
          "^build"
        ]
      },
      "dev:local": {
        "cache": false,
        "continuous": true
      },
      "start": {
        "cache": false,
        "continuous": true
      }
    }
  }
}
