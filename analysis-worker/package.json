{
  "name": "@sidechannel/analysis-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node ../scripts/test.mjs src",
    "lint": "eslint src",
    "dev": "node ../scripts/dev.mjs analysis-worker",
    "dev:local": "tsx watch --env-file-if-exists=../.env --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=../.env --env-file-if-exists=.env dist/main.js",
    "jev:worker": "tsx --env-file-if-exists=../.env --env-file-if-exists=.env src/commands/jev-analysis-worker.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.7.0",
    "@mastra/core": "1.82.0",
    "zod": "4.6.7",
    "@sidechannel/contracts": "1.0.0",
    "@sidechannel/domain": "1.0.0",
    "@sidechannel/persistence": "1.0.0",
    "mongodb": "7.7.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "26.6.6",
    "tsx": "4.21.0"
  },
  "nx": {
    "tags": [
      "layer:service"
    ],
    "targets": {
      "dev": {
        "cache": false,
        "continuous": true,
        "dependsOn": [
          "^build"
        ]
      },
      "dev:local": {
        "cache": false,
        "continuous": true
      },
      "start": {
        "cache": false,
        "continuous": true
      },
      "jev:worker": {
        "cache": false,
        "continuous": true
      }
    }
  },
  "main": "./dist/main.js"
}
